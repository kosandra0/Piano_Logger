{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Piano Logger",
  "version": "7.0.0",
  "identifier": "com.kosandra0.pianologger",
  "build": {
    "frontendDist": "../web",
    "beforeDevCommand": "npm run prepare-page",
    "beforeBuildCommand": "npm run prepare-page"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "kosandra0",
    "copyright": "kosandra0",
    "category": "Music",
    "shortDescription": "Piano MIDI visualizer and lifetime key logger",
    "longDescription": "Piano Logger shows what you play on a MIDI keyboard and saves every key press on your own computer, with statistics, practice tools and 190+ themes.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      }
    }
  }
}
